<Mod>
	<Name>Sound Blocks</Name>
	<Author>wizz6rd</Author>
	<Version>0.2.1</Version>
	
	<Description>
	Adds a block to play preloaded sounds upon key press.
	Multiple playback options are available, MP supported.
	</Description>
	
	<Icon name="SoundBlocks_icon" />
	<Debug>false</Debug>
	<MultiplayerCompatible>true</MultiplayerCompatible>

	<Assemblies>
		<Assembly path="SoundBlocks.dll" />
	</Assemblies>

	<Blocks>
		<Block path="SoundBlock.xml" />
	</Blocks>
	
	<Resources>
		<Mesh name="SoundBlock_mesh" path="SoundBlock\SoundBlock.obj" />
		<Texture name="SoundBlock_texture" path="SoundBlock\SoundBlock.png" />
		
		<Texture name="SoundBlocks_icon" path="SoundBlocks.png" />
		
		<!-- Normal Sounds -->
		<AudioClip name="Bike Horn" path="Sounds\BikeHorn.ogg" />
